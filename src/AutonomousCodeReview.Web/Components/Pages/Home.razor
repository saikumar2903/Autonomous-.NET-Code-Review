@page "/"

<PageTitle>Autonomous Code Review - AI-Powered Multi-Agent System</PageTitle>

<div class="hero-section text-center py-5">
    <div class="container">
        <h1 class="display-3 fw-bold mb-4">
            <i class="fas fa-robot text-primary"></i> Autonomous Code Review
        </h1>
        <p class="lead mb-4">
            Experience the future of code review with our AI-powered multi-agent system that automatically analyzes your code for security vulnerabilities, quality issues, and best practices.
        </p>
        <div class="row justify-content-center mb-5">
            <div class="col-md-8">
                <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                    <a href="/code-review" class="btn btn-primary btn-lg me-md-2">
                        <i class="fas fa-code"></i> Start Code Review
                    </a>
                    <a href="#features" class="btn btn-outline-primary btn-lg">
                        <i class="fas fa-info-circle"></i> Learn More
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<section id="features" class="py-5">
    <div class="container">
        <h2 class="text-center mb-5">Powered by AI Agents</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-shield-alt fa-3x text-danger"></i>
                        </div>
                        <h4>Security Review Agent</h4>
                        <p class="card-text">
                            Automatically detects security vulnerabilities including SQL injection, 
                            hardcoded secrets, and potential attack vectors in your code.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-gem fa-3x text-success"></i>
                        </div>
                        <h4>Code Quality Agent</h4>
                        <p class="card-text">
                            Analyzes code for maintainability, best practices, naming conventions, 
                            and suggests improvements for better code quality.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-brain fa-3x text-primary"></i>
                        </div>
                        <h4>AI Orchestrator</h4>
                        <p class="card-text">
                            Coordinates multiple AI agents to provide comprehensive code analysis 
                            with intelligent prioritization and actionable insights.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h3>How It Works</h3>
                <ol class="list-group list-group-flush">
                    <li class="list-group-item bg-transparent">
                        <strong>1. Submit Your Code</strong><br>
                        Provide a repository URL or paste code snippets directly
                    </li>
                    <li class="list-group-item bg-transparent">
                        <strong>2. AI Agent Analysis</strong><br>
                        Multiple specialized agents analyze different aspects of your code
                    </li>
                    <li class="list-group-item bg-transparent">
                        <strong>3. Comprehensive Report</strong><br>
                        Receive detailed feedback with quality scores and actionable suggestions
                    </li>
                </ol>
            </div>
            <div class="col-md-6">
                <div class="text-center">
                    <i class="fas fa-cogs fa-5x text-muted"></i>
                    <p class="mt-3 text-muted">Automated, Intelligent, Efficient</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        margin: -2rem -15px 0 -15px;
    }
    
    .card {
        border: none;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease-in-out;
    }
    
    .card:hover {
        transform: translateY(-5px);
    }
    
    .feature-icon {
        padding: 1rem;
    }
</style>
